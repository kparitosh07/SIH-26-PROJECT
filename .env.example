# ============================================================
# Label Compliance Checker - Environment Configuration
# Copy this file to .env and customize for your environment
# ============================================================

# --- Application ---
APP_NAME="Label Compliance Checker"
APP_ENV=development
DEBUG=true
API_V1_PREFIX="/api/v1"
BASE_URL="http://localhost:8000"

# --- Security ---
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
SECRET_KEY="change-me-in-production-9f8f7e6d"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Database ---
DATABASE_URL="postgresql+psycopg2://label_user:label_pass@localhost:5432/label_compliance"
DB_ECHO=false

# --- Redis / Celery ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# --- Storage ---
# Options: local, s3
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR="./uploads"
S3_BUCKET="label-compliance-uploads"
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_TYPES=".png,.jpg,.jpeg,.pdf,.webp,.bmp"

# --- CORS ---
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- OCR ---
OCR_ENGINE=paddleocr
OCR_LANG=en
PADDLE_DEVICE=cpu
OCR_DPI=300
OCR_CONFIDENCE_THRESHOLD=0.45

# --- Rate Limiting ---
RATE_LIMIT_UPLOAD=60/minute
RATE_LIMIT_GENERAL=120/minute

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE="./logs/app.log"

# --- Admin seed ---
INIT_ADMIN_PASSWORD=Admin@12345

# --- Reports ---
REPORT_DIR="./reports"
PDF_LICENSE_HEADER="Compliance assessment performed by AI-based Label Compliance Checker. This report is a machine-generated draft and does not substitute certified laboratory or legal verification."

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100